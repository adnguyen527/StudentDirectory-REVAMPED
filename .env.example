# Copy to .env and fill in real values. .env is gitignored -- never commit it.
#
# Full MongoDB Atlas connection string, including credentials:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=StudentDirectory
#
# If the password contains any of : / ? # [ ] @ it must be percent-encoded.
MONGODB_URI=

# Database name (optional, defaults to StudentDirectory)
MONGODB_DB=StudentDirectory

# Shared key for the X-API-Key header. Every route except /api/health requires it.
# Unset means protected routes return 500 rather than serving student data openly.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# This is a server-side credential. Do NOT ship it to a browser frontend -- anything the
# JavaScript can send, a user can read out of the bundle. A browser client needs session
# cookies instead; see auth.py.
API_KEY=

# Browser origins allowed to read /api/* responses, comma-separated. Optional --
# defaults to the local dev servers (localhost and 127.0.0.1 on ports 5173 and 3000).
#   ALLOWED_ORIGINS=https://directory.example.com
# '*' allows any origin and must be set deliberately; note that browsers refuse to send
# cookies to a wildcard origin, so '*' is incompatible with session auth.
ALLOWED_ORIGINS=
