# Copy to .env and fill in real values. .env is gitignored -- never commit it.
#
# Full MongoDB Atlas connection string, including credentials:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=StudentDirectory
#
# If the password contains any of : / ? # [ ] @ it must be percent-encoded.
MONGODB_URI=

# Database name (optional, defaults to StudentDirectory)
MONGODB_DB=StudentDirectory

# Shared key for the X-API-Key header, for server-side callers and scripts.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Optional now that session auth exists: a deployment serving only the browser frontend
# can leave this blank, and protected routes simply answer 401. A server with neither a
# key nor a user account is reachable by nobody, and app.py says so on startup.
#
# This is a server-side credential. Do NOT ship it to a browser frontend -- anything the
# JavaScript can send, a user can read out of the bundle. Browsers log in instead; see
# the session settings below and scripts/create_user.py.
API_KEY=

# Browser origins allowed to read /api/* responses, comma-separated. Optional --
# defaults to the local dev servers (localhost and 127.0.0.1 on ports 5173 and 3000).
#   ALLOWED_ORIGINS=https://directory.example.com
# '*' allows any origin and must be set deliberately; note that browsers refuse to send
# cookies to a wildcard origin, so '*' is incompatible with session auth.
ALLOWED_ORIGINS=

# Development server. All optional; the defaults are the safe ones.
#
# FLASK_DEBUG=1 installs the Werkzeug debugger, whose traceback pages carry a console
# that runs arbitrary Python in the server process -- with MONGODB_URI and API_KEY in
# reach. Keep it off unless you are actively debugging, and never with a non-loopback
# HOST: the two together put that console on your local network.
FLASK_DEBUG=0

# HOST=0.0.0.0 binds every interface, so the server becomes reachable from any device
# on the same network. The default binds loopback only.
HOST=127.0.0.1
PORT=5000

# --- Session authentication ---
#
# All optional; every default below is the safe one. Accounts are created with
# scripts/create_user.py -- there is no signup route. See auth.py and the README.
#
# No signing secret appears here and none is needed: a session is a random token
# validated by a database lookup, so there is no key to leak or rotate.

# How long a login lasts, in hours. Absolute, not sliding -- the clock starts at login
# and is not extended by activity. Default 12, one working shift.
SESSION_TTL_HOURS=12

# Name of the cookie. Only worth changing if two of these apps share a hostname.
SESSION_COOKIE_NAME=sd_session

# Whether the cookie is marked Secure (https only). Defaults to whether HOST is
# non-loopback, which is the same question: local development runs over plain http,
# where a Secure cookie is SILENTLY DISCARDED by the browser -- forcing it on there
# produces a login that appears to succeed and then does nothing. A real deployment
# must have it on, and gets it without setting anything.
SESSION_COOKIE_SECURE=

# Failed logins before the account locks, and for how long. The tradeoff is deliberate:
# with a handful of staff accounts, someone who knows a username can lock it for the
# window below. That is accepted as cheaper than an unthrottled password endpoint.
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=15

# Password hashing work factor -- werkzeug's own default, spelled out so it is a number
# you can reason about. The ~100ms it costs is the security property: it is what makes a
# stolen hash expensive to attack offline.
#
# NEVER lower this in a deployment. The test suite does, because ~100ms times several
# hundred logins is a 20-second suite instead of a 3-second one, and only the work
# factor changes -- the algorithm and the verification path are the ones that run here.
PASSWORD_HASH_METHOD=scrypt:32768:8:1
